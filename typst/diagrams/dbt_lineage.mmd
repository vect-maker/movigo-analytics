%% Diagrama de Linaje y Modelado Dimensional en dbt Core - MoviGo
flowchart LR
    %% =========================================================================
    %% ESTILOS VISUALES Y PALETA DE COLORES MAESTRA
    %% =========================================================================
    classDef default fill:#F8FAFC,stroke:#334155,stroke-width:1.8px,color:#0F172A,font-size:16px;
    classDef rawNode fill:#EFF6FF,stroke:#2563EB,stroke-width:2.2px,color:#1E3A8A,font-size:15.5px;
    classDef stgNode fill:#FEF3C7,stroke:#D97706,stroke-width:2.2px,color:#78350F,font-size:15.5px;
    classDef fctNode fill:#ECFDF5,stroke:#059669,stroke-width:2.8px,color:#064E3B,font-size:16.5px;
    classDef dimNode fill:#F1F5F9,stroke:#334155,stroke-width:2.2px,color:#0F172A,font-size:15.5px;

    %% =========================================================================
    %% CAPA 1: RAW LAYER (POSTGRESQL - ESQUEMA 3NF)
    %% =========================================================================
    subgraph RAW ["<b style='font-size:17px;'>I. RAW LAYER (PostgreSQL)</b>"]
        direction TB
        R_GEO[("`**raw.urban_zones**
        24 zonas y 298 cuadrantes WGS84`")]:::rawNode

        R_CLIMA[("`**raw.quadrant_weather**
        Meteorología horaria y escorrentía`")]:::rawNode

        R_ACTORS[("`**raw.users & drivers**
        Conductores, usuarios y flota`")]:::rawNode

        R_TRIP[("`**raw.trips**
        100k registros transaccionales`")]:::rawNode
    end

    %% =========================================================================
    %% CAPA 2: STAGING LAYER (DBT CORE - VISTAS 1:1)
    %% =========================================================================
    subgraph STG ["<b style='font-size:17px;'>II. STAGING LAYER (dbt Views)</b>"]
        direction TB
        S_GEO["`**stg_urban_zones**
        Normalización espacial y cauces`"]:::stgNode

        S_CLIMA["`**stg_weather**
        Microclima horario por cuadrante`"]:::stgNode

        S_ACTORS["`**stg_users & drivers**
        Estratificación y perfil activo`"]:::stgNode

        S_TRIP["`**stg_trips & payments**
        Tipado, desglose surge e is_cancelled`"]:::stgNode
    end

    %% =========================================================================
    %% CAPA 3: MARTS LAYER (KIMBALL STAR SCHEMA - TABLAS)
    %% =========================================================================
    subgraph MARTS ["<b style='font-size:17px;'>III. MARTS (Star Schema)</b>"]
        direction TB
        D_ZONES["`**dim_zones & quadrants**
        Role-playing: origen / destino`"]:::dimNode

        D_CLIMA["`**dim_weather**
        Régimen hídrico y severidad pluvial`"]:::dimNode

        D_ACTORS["`**dim_users & drivers**
        Segmentación de demanda y flota`"]:::dimNode

        F_TRIP["`**fct_trips (Fact Table)**
        • 77,487 viajes (grain atómico)
        • Surrogate keys conformadas (MD5)
        • Métricas operacionales y surge`"]:::fctNode
    end

    %% =========================================================================
    %% CONEXIONES DIRECTAS Y LIMPIAS ENTRE CAPAS
    %% =========================================================================
    R_GEO --> S_GEO
    R_CLIMA --> S_CLIMA
    R_ACTORS --> S_ACTORS
    R_TRIP --> S_TRIP

    S_GEO --> D_ZONES
    S_CLIMA --> D_CLIMA
    S_ACTORS --> D_ACTORS
    S_TRIP ==> F_TRIP

    D_ZONES -.-> F_TRIP
    D_CLIMA -.-> F_TRIP
    D_ACTORS -.-> F_TRIP
